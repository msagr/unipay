{
  "name": "unipay",
  "version": "1.0.0",
  "description": "A unified payment management platform",
  "homepage": "https://github.com/msagr/unipay#readme",
  "bugs": {
    "url": "https://github.com/msagr/unipay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msagr/unipay.git"
  },
  "scripts": {
    "docker:up": "docker compose -f local.yml up -d --remove-orphans",
    "docker:build": "docker compose -f local.yml up --build -d",
    "docker:down": "docker compose -f local.yml down --remove-orphans",
    "docker:destruct": "docker compose -f local.yml down -v",
    "docker:logs": "docker compose -f local.yml logs",
    "docker:api": "docker compose -f local.yml up --build --force-recreate -d api",
    "docker:logs-api": "docker compose -f local.yml logs api",
    "docker:user-api": "docker run --rm unipay-api whoami",
    "docker:volume-api": "docker volume inspect unipay_mongo-data",
    "docker:frontend": "docker compose -f local.yml up --build --force-recreate -d frontend",
    "docker:logs-frontend": "docker compose -f local.yml logs frontend",
    "docker:user-frontend": "docker run --rm unipay-frontend whoami",
    "docker:volume-frontend": "docker volume inspect unipay_mongo-data",
    "dev": "npm run docker:up && npm run docker:logs api"
  },
  "license": "MIT",
  "author": "msagr",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "express-mongo-sanitize": "^2.2.0"
  }
}
